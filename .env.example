# --- Walrus Memory (MemWal) ---
# From the playground at https://memory.walrus.xyz (use a dedicated wallet).
# Leave both empty to run on the in-memory mock (nothing is written to Walrus).
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
# "dev" or "prod" — becomes part of every namespace so test data never mixes with real users.
MEMWAL_ENV=dev
# Force the in-memory mock even when keys are set (1 = on).
MEMWAL_MOCK=
# Random secret used to hash user IDs into namespaces. Set once, never change it
# (changing it orphans every existing memory).
USER_ID_SALT=change-me

# --- LLM (any OpenAI-compatible chat API) ---
# Default: Meta Model API (Muse Spark).
LLM_BASE_URL=https://api.meta.ai/v1
LLM_API_KEY=
LLM_MODEL=muse-spark-1.3-contributor
# minimal | low | medium | high — lower = faster + cheaper replies
LLM_REASONING_EFFORT=minimal


# --- Speech-to-text (OpenAI-compatible /audio/transcriptions) ---
# Used for Telegram voice notes and for browsers without the Web Speech API.
# Groq has a free tier: https://console.groq.com
STT_BASE_URL=https://api.groq.com/openai/v1
STT_API_KEY=
STT_MODEL=whisper-large-v3-turbo

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Random string; Telegram sends it back on every webhook call so we can reject fakes.
TELEGRAM_WEBHOOK_SECRET=
